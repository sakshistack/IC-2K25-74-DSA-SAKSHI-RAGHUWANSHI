#include <iostream>
#define MAX 5

using namespace std;

class Deque
{
    int a[MAX], front, rear, x;

public:
    Deque()
    {
        front = -1;
        rear = -1;
    }
    void insert_front();
    void insert_rear();
    void delete_front();
    void delete_rear();
    void display();
};

void Deque::insert_front()
{
    if ((front == 0 && rear == MAX - 1) || (front == rear + 1))
    {
        cout << "Deque is full (Overflow)\n";
    }
    else
    {
        cout << "Enter element: ";
        cin >> x;
        if (front == -1)
        {
            front = 0;
            rear = 0;
        }
        else if (front == 0)
        {
            front = MAX - 1;
        }
        else
        {
            front--;
        }
        a[front] = x;
        cout << "Inserted at front successfully\n";
    }
}

void Deque::insert_rear()
{
    if ((front == 0 && rear == MAX - 1) || (front == rear + 1))
    {
        cout << "Deque is full (Overflow)\n";
    }
    else
    {
        cout << "Enter element: ";
        cin >> x;
        if (front == -1)
        {
            front = 0;
            rear = 0;
        }
        else if (rear == MAX - 1)
        {
            rear = 0;
        }
        else
        {
            rear++;
        }
        a[rear] = x;
        cout << "Inserted at rear successfully\n";
    }
}

void Deque::delete_front()
{
    if (front == -1)
    {
        cout << "Deque is empty (Underflow)\n";
    }
    else
    {
        x = a[front];
        if (front == rear)
        {
            front = -1;
            rear = -1;
        }
        else if (front == MAX - 1)
        {
            front = 0;
        }
        else
        {
            front++;
        }
        cout << "Deleted item from front = " << x << "\n";
    }
}

void Deque::delete_rear()
{
    if (front == -1)
    {
        cout << "Deque is empty (Underflow)\n";
    }
    else
    {
        x = a[rear];
        if (front == rear)
        {
            front = -1;
            rear = -1;
        }
        else if (rear == 0)
        {
            rear = MAX - 1;
        }
        else
        {
            rear--;
        }
        cout << "Deleted item from rear = " << x << "\n";
    }
}

void Deque::display()
{
    if (front == -1)
    {
        cout << "Deque has no elements\n";
    }
    else
    {
        cout << "Deque elements: ";
        int i = front;
        while (true)
        {
            cout << a[i] << " ";
            if (i == rear)
                break;
            i = (i + 1) % MAX;
        }
        cout << "\n";
    }
}

int main()
{
    Deque dq;
    int choice;
    char C;

    do
    {
        cout << "\n1. Insert Front  2. Insert Rear\n3. Delete Front  4. Delete Rear\n5. Display\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            dq.insert_front();
            break;
        case 2:
            dq.insert_rear();
            break;
        case 3:
            dq.delete_front();
            break;
        case 4:
            dq.delete_rear();
            break;
        case 5:
            dq.display();
            break;
        default:
            cout << "Invalid choice\n";
        }

        cout << "You want to continue? (y/n): ";
        cin >> C;
    } while (C == 'y' || C == 'Y');

    return 0;
}
