#include <iostream>
#define MAX 4

using namespace std;

class mst
{
    int a[MAX], top1, top2;

public:
    mst()
    {
        top1 = -1;
        top2 = MAX;
    }
    void push1();
    void push2();
    void pop1();
    void pop2();
    void show1();
    void show2();
};

void mst::push1()
{
    int x;
    if (top1 + 1 == top2)
    {
        cout << "Stack overflow\n";
    }
    else
    {
        cout << "enter value: ";
        cin >> x;
        top1++;
        a[top1] = x;
    }
}

void mst::push2()
{
    int x;
    if (top2 == top1 + 1)
    {
        cout << "Stack 2 overflow\n";
    }
    else
    {
        cout << "enter the value: ";
        cin >> x;
        top2--;
        a[top2] = x;
    }
}

void mst::pop1()
{
    int x;
    if (top1 == -1)
    {
        cout << "stack underflow\n";
    }
    else
    {
        x = a[top1];
        top1--;
        cout << "element removed\n";
    }
}

void mst::pop2()
{
    int x;
    if (top2 == MAX)
    {
        cout << "stack underflow\n";
    }
    else
    {
        x = a[top2];
        top2++;
        cout << "element removed\n";
    }
}

void mst::show1()
{
    if (top1 == -1)
    {
        cout << "No elements present\n";
    }
    else
    {
        cout << "Stack 1 elements: ";
        for (int i = top1; i >= 0; i--)
        {
            cout << a[i] << " ";
        }
        cout << "\n";
    }
}

void mst::show2()
{
    if (top2 == MAX)
    {
        cout << "No element present\n";
    }
    else
    {
        cout << "Stack 2 elements: ";
        for (int i = top2; i < MAX; i++)
        {
            cout << a[i] << " ";
        }
        cout << "\n";
    }
}

