#include <iostream>

using namespace std;

struct node
{
    int data;
    node *link;
};

class StackLL
{
    node *top; // 'top' acts as the start pointer for the stack

public:
    void push();
    void pop();
    void display();
    
    StackLL()
    {
        top = NULL;
    }
    ~StackLL();
};

void StackLL::push()
{
    node *nn = new node;
    cout << "Enter data to push: ";
    cin >> nn->data;
    nn->link = top;
    top = nn;
    cout << "Item pushed successfully.\n";
}

void StackLL::pop()
{
    if (top == NULL)
    {
        cout << "Stack Underflow! No elements to pop.\n";
        return;
    }

    node *temp = top;
    top = top->link;
    cout << "Popped item: " << temp->data << "\n";
    delete temp;
}


void StackLL::display()
{
    if (top == NULL)
    {
        cout << "Stack is empty.\n";
        return;
    }

    node *temp = top;
    cout << "Stack elements (Top to Bottom):\n";
    while (temp != NULL)
    {
        cout << temp->data << "\n";
        cout << "-----\n";
        temp = temp->link;
    }
}

StackLL::~StackLL()
{
    node *t;
    while (top != NULL)
    {
        t = top;
        top = top->link;
        delete t;
    }
}

int main()
{
    StackLL s1;
    char C;
    int choice;

    do
    {
        cout << "\n--- STACK USING LINKED LIST ---\n";
        cout << "1. Push\n2. Pop\n3.Display\n";
        cout << "Enter your choice: ";
        cin >> choice;
        
        switch (choice)
        {
        case 1:
            s1.push();
            break;
        case 2:
            s1.pop();
            break;
        case 3:
            s1.display();
            break;
        default:
            cout << "Invalid choice!\n";
        }
        
        cout << "\nWant to continue? (y/n): ";
        cin >> C;
    } while (C == 'y' || C == 'Y');
    
    return 0;
}
