#include <iostream.h>
using namespace std ;

struct node
{
    int data;
    node *next;
    node *prev;
};

class DoublyLL
{
    node *start;

public:
    void create();
    void display();
    void count();
    void search(int num);
    void insert(int pos, int val);
    void delete_node();
    
    DoublyLL()
    {
        start = NULL;
    }
    ~DoublyLL();
};

void DoublyLL::create()
{
    node *nn = new node;
    cout << "Enter data: ";
    cin >> nn->data;
    nn->next = NULL;
    nn->prev = NULL;

    if (start == NULL)
    {
        start = nn;
    }
    else
    {
        node *temp = start;
        while (temp->next != NULL)
        {
            temp = temp->next;
        }
        temp->next = nn;
        nn->prev = temp;
    }
}

void DoublyLL::insert(int pos, int val)
{
    node *nn = new node();
    nn->data = val;
    nn->next = NULL;
    nn->prev = NULL;

    if (pos == 1 || start == NULL)
    {
        nn->next = start;
        if (start != NULL)
        {
            start->prev = nn;
        }
        start = nn;
    }
    else
    {
        node *temp = start;
        int i = 1;
        while (i < (pos - 1) && temp->next != NULL)
        {
            temp = temp->next;
            i++;
        }
        
        nn->next = temp->next;
        nn->prev = temp;
        
        if (temp->next != NULL)
        {
            temp->next->prev = nn;
        }
        temp->next = nn;
    }
}

void DoublyLL::count()
{
    int i = 0;
    node *temp = start;
    if (start == NULL)
    {
        cout << "Doubly LL has no elements";
    }
    else
    {
        while (temp != NULL)
        {
            i++;
            temp = temp->next;
        }
        cout << "Total elements: " << i;
    }
}

void DoublyLL::search(int num)
{
    node *t = start;
    int F = 0;
    int i = 0;
    
    if (t == NULL)
    {
        cout << "List is empty";
        return;
    }

    do
    {
        i++;
        if (t->data == num)
        {
            F = 1;
            cout << "Element found at position " << i;
            break;
        }
        else
        {
            t = t->next;
        }
    } while (t != NULL);

    if (F == 0)
    {
        cout << "Element not found";
    }
}

void DoublyLL::delete_node()
{
    node *t = start;
    int num;
    
    if (start == NULL)
    {
        cout << "List is empty, nothing to delete";
        return;
    }

    cout << "Enter element to delete: ";
    cin >> num;

    while (t != NULL)
    {
        if (t->data == num)
        {
            if (t == start)
            {
                start = t->next;
                if (start != NULL)
                {
                    start->prev = NULL;
                }
            }
            else
            {
                t->prev->next = t->next;
                if (t->next != NULL)
                {
                    t->next->prev = t->prev;
                }
            }
            delete t;
            cout << "Deleted item successfully";
            return;
        }
        else
        {
            t = t->next;
        }
    }
    cout << "Data not found";
}

void DoublyLL::display()
{
    node *temp = start;
    if (temp == NULL)
    {
        cout << "List is empty";
        return;
    }
    cout << "Forward Traversal: ";
    while (temp != NULL)
    {
        cout << temp->data << " <-> ";
        temp = temp->next;
    }
    cout << "NULL";
}

DoublyLL::~DoublyLL()
{
    node *t;
    while (start != NULL)
    {
        t = start;
        start = start->next;
        delete t;
    }
}

int main()
{
    DoublyLL l2;
    char C;
    int choice;
    int pos, num;

    do
    {
        cout << "\n1. Create 2. Insert 3. Delete 4. Display 5. Count 6. Search\n";
        cout << "Enter your choice: ";
        cin >> choice;
        
        switch (choice)
        {
        case 1:
            l2.create();
            break;
        case 2:
            cout << "Enter position and value: ";
            cin >> pos >> num;
            l2.insert(pos, num);
            break;
        case 3:
            l2.delete_node();
            break;
        case 4:
            l2.display();
            break;
        case 5:
            l2.count();
            break;
        case 6:
            cout << "Enter number to search: ";
            cin >> num;
            l2.search(num);
            break;
        }
        cout << "\nWant to continue? (y/n): ";
    } while (C == 'y' || C == 'Y');
    
}
