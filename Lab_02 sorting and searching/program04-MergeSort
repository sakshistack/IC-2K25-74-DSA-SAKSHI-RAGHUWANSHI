// Simple Merge Sort in C++
#include <iostream>
using namespace std;

int arr[7] = {38, 27, 43, 3, 9, 82, 10};   // array to sort
int temp[7];                               // temporary array used while merging

// Step 3: merge two sorted parts into one sorted part
void merge(int low, int mid, int high) {
    int i = low;        // start of left part
    int j = mid + 1;    // start of right part
    int k = low;        // position in temp array

    // pick the smaller element each time
    while (i <= mid && j <= high) {
        if (arr[i] <= arr[j]) {
            temp[k] = arr[i];
            i++;
        } else {
            temp[k] = arr[j];
            j++;
        }
        k++;
    }

    // copy the remaining elements of the left part
    while (i <= mid) {
        temp[k] = arr[i];
        i++;
        k++;
    }

    // copy the remaining elements of the right part
    while (j <= high) {
        temp[k] = arr[j];
        j++;
        k++;
    }

    // copy everything back to the original array
    for (int x = low; x <= high; x++) {
        arr[x] = temp[x];
    }
}

// Step 1 and 2: divide the array and sort each half
void mergeSort(int low, int high) {
    if (low < high) {
        int mid = (low + high) / 2;

        mergeSort(low, mid);        // sort left half
        mergeSort(mid + 1, high);   // sort right half
        merge(low, mid, high);      // merge both halves
    }
}

int main() {
    cout << "Before sorting: ";
    for (int i = 0; i < 7; i++) {
        cout << arr[i] << " ";
    }

    mergeSort(0, 6);   // sort from index 0 to index 6

    cout << "\nAfter sorting : ";
    for (int i = 0; i < 7; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    return 0;
}
